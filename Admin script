    def create_profile(profile_filename):
        folder_path = Path(os.path.expanduser("~/.visitors")) / f"{profile_filename}.json"
        os.makedirs(folder_path.parent, exist_ok=True)
        sorted_colours = set()
        profile_data = {
            "playercount": globals().get("playercount")
        }
        for C in range(1, globals().get("playercount") + 1):
            profile_data[f"player_name_{C}"] = globals().get(f"player_name_{C}")
            player_colour = globals().get(f"colour_{C}")
            profile_data[f"colour_{C}"] = player_colour
            if player_colour and player_colour not in sorted_colours and globals().get("team_how") == "dependant":
                profile_data[player_colour] = globals().get(player_colour)
                sorted_colours.add(player_colour)
            else:
                profile_data[f"team_name_alt_{C}"] = globals().get(f"team_name_alt_{C}")
            profile_data[f"which_h_{C}?"] = globals().get(f"which_h_{C}?")
            profile_data[f"which_v_{C}?"] = globals().get(f"which_v_{C}?")
            if f"extra_colour_{C}" in globals():
                profile_data[f"extra_colour_{C}"] = globals().get(f"extra_colour_{C}")
                profile_data[f"h_pos_{C}"] = globals().get(f"h_pos_{C}")
                profile_data[f"v_pos_{C}"] = globals().get(f"v_pos_{C}")
                profile_data[f"death_penalty"] = globals().get("death_penalty")
        profile_data["time_stamp"] = datetime.now().strftime("%Y-%m-%d")
        with open(folder_path, "w", encoding="utf-8") as file:
            json.dump(profile_data, file, indent=4)


    def load_profile():
        whichprofile = tk.Toplevel(root)
        whichprofile.title("Select Profile")
        whichprofile.geometry("450x350")
        whichprofile.transient(root)

        label = tk.Label(whichprofile, text="Profiles:", font=("Arial", 16, "bold"))
        label.pack(pady=10)

        folder_path = Path(os.path.expanduser("~/.visitors"))
        database = {}
        raw_profiles = {}
        cutoff_date = datetime.now() - timedelta(days=365)

        if folder_path.exists():
            for file_path in folder_path.glob("*.json"):
                try:
                    with open(file_path, "r", encoding="utf-8") as file:
                        content = json.load(file)
                    ts_str = content.get("time_stamp")
                    file_date = None

                    if isinstance(ts_str, str):
                        for fmt in ("%d.%m.%Y", "%d.%m.%Y %H:%M", "%Y-%m-%d"):
                            try:
                                file_date = datetime.strptime(ts_str, fmt)
                                break
                            except ValueError:
                                continue
                    elif isinstance(ts_str, (int, float)):
                        file_date = datetime.fromtimestamp(ts_str)

                    if file_date is None:
                        file_date = datetime.fromtimestamp(file_path.stat().st_mtime)

                    if file_date < cutoff_date:
                        file_path.unlink()
                        print(f"Abgelaufenes Profil gelöscht: {file_path.name}")
                        continue

                    raw_profiles[file_path.name] = content
                    database[file_path.name] = json.dumps(content).lower()

                except (json.JSONDecodeError, OSError):
                    pass

        def update_results(event=None):
            query = search_var.get().strip().lower()
